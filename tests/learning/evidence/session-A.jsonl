nition.ai/icon":"zap","cognition.ai/category":"Session"}},{"name":"goal","description":"Set a goal the agent keeps working on until it is done","input":{"hint":"[<objective>|resume|clear]"},"_meta":{"cognition.ai/icon":"target","cognition.ai/category":"Session"}},{"name":"recap","description":"Recap the session so far with a short summary","_meta":{"cognition.ai/icon":"history","cognition.ai/category":"Session"}},{"name":"session-stats","description":"Show session statistics","_meta":{"cognition.ai/icon":"bar-chart-2","cognition.ai/category":"Session"}},{"name":"rename","description":"Rename this session","input":{"hint":"[new title]"},"_meta":{"cognition.ai/icon":"pencil","cognition.ai/category":"Session"}},{"name":"share","description":"Share this conversation with your team on Devin","_meta":{"cognition.ai/icon":"share-2","cognition.ai/category":"Session"}},{"name":"mcp","description":"List configured MCP servers and their status","_meta":{"cognition.ai/icon":"plug","cognition.ai/category":"System"}},{"name":"bug","description":"Report a bug to the Devin CLI developers","input":{"hint":"<description>"},"_meta":{"cognition.ai/icon":"bug","cognition.ai/category":"System"}},{"name":"help","description":"Show available commands","_meta":{"cognition.ai/icon":"help-circle","cognition.ai/category":"Session"}},{"name":"architectural-dxf-drawing","description":"Use when producing DXF/DWG construction drawings from a confirmed interior design model — layering, lineweights, dimension styles, drawing-sheet organization with ezdxf or similar CAD scripting.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"architectural-render-qc","description":"Use when generating or reviewing interior/architectural renderings — CAD-locked camera views, image-edit passes over base renders, or checking whether a render matches the floor plan (invented windows/furniture, wrong orientations, floating objects).","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"floorplan-reconstruction","description":"Use when reconstructing parametric geometry from a raster/scanned floor plan (PNG/JPG/PDF) or converting between plan sources (PNG vs DWG/DXF) that may disagree — before any 3D modeling, rendering, or space planning depends on it.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"grill-me","description":"Interview the user relentlessly about a plan or design until reaching shared understanding, resolving each branch of the decision tree. Use when user wants to stress-test a plan, get grilled on their design, or mentions \"grill me\".","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"interior-construction-docs","description":"Use when producing construction drawing sets (施工图) for an interior project — demolition/new-wall/furniture/ceiling/lighting/socket/plumbing/floor/elevation sheets — only after renderings are client-confirmed.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"playwright-cli","description":"Automate browser interactions, test web pages and work with Playwright tests.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"residential-interior-design","description":"Use when making interior design judgments for a residence — style direction, material palette, furniture/appliance selection logic, custom cabinetry — especially modern natural-wood / minimal styles, before renderings or construction docs.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"space-planning","description":"Use when proposing or revising a residential interior layout — room functions, furniture footprints, circulation, kitchen/bath zoning — before drawing anything, and whenever a user asks to optimize a floor plan.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"ego-browser","description":"When you need a browser, read this Skill by default. Use it to open and operate websites, fill forms, click buttons, take screenshots, extract page data, sign in, and perform other browser automation tasks, as well as web app testing, dogfooding, QA, bug investigation, and app-quality review. ego-browser (ego-lite) is a Chromium browser designed for both human users and AI Agents. Agents can use the user's logged-in websites and personal context to complete tasks and collaborate smoothly with the user through the browser interface. Therefore, prefer ego-browser over built-in browsers or other web tools.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"declarative-repo-setup","description":"Generate and verify a working environment.yaml (Devin snapshot-setup blueprint) for a repo","input":{"hint":"<owner/repo>"},"_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"upload-secrets","description":"Securely upload local secrets (dotenv files, env vars, API keys) to the Devin Cloud secrets manager — values never enter the conversation","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"devin-playbooks:hi-i-m-devin","description":"Hi, I'm Devin. Overview.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}}]}}}
